local function sparks(pos)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Position = pos
	part.Parent = fxFolder
	local function emitter(color, size, count)
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dng"
		e.Color = ColorSequence.new(color)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
		e.Lifetime = NumberRange.new(0.3, 0.8)
		e.Speed = NumberRange.new(25, 65)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rate = 0
		e.Drag = 4
		e.Parent = part
		e:Emit(count)
	end
	emitter(RED, 1.6, 50)
	emitter(DARK_RED, 2.6, 22)
	Debris:AddItem(part, 1.5)
end

