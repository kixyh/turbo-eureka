-- ================= dummies =================
local dummies = {}

local function countDummies()
	local n = 0
	for model, d in pairs(dummies) do
		if model.Parent and d.torso.Parent then
			n += 1
		else
			dummies[model] = nil
		end
	end
	return n
end

local function updateBar(d)
	local r = d.hp / d.max
	TweenService:Create(d.fill, TweenInfo.new(0.2), {
		Size = UDim2.new(r, 0, 1, 0),
		BackgroundColor3 = Color3.fromHSV(0.33 * r, 0.85, 1),
	}):Play()
	d.label.Text = "DUMMY  " .. math.ceil(d.hp) .. "/" .. d.max
end

local function newPart(model, name, size, color, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.6, 0.1, 1, 1)
	if shape then p.Shape = shape end
	p.Parent = model
	return p
end

local function spawnDummy(pos)
	if countDummies() >= CONFIG.MaxDummies then
		say("Dummy limit reached (" .. CONFIG.MaxDummies .. "). Use !clear")
		return
	end
	local gy = groundAt(pos) or pos.Y - 2.5
	local base = Vector3.new(pos.X, gy + 3.05, pos.Z)
	local root = getRoot()
	local look = root and Vector3.new(root.Position.X, base.Y, root.Position.Z) or (base + Vector3.new(0, 0, -1))
	local cf = CFrame.lookAt(base, look)

	local model = Instance.new("Model")
	model.Name = "BF_Dummy"

	local skin = Color3.fromRGB(235, 200, 160)
	local torso = newPart(model, "Torso", Vector3.new(2, 2, 1), Color3.fromRGB(70, 90, 140))
	local head = newPart(model, "Head", Vector3.new(1.3, 1.3, 1.3), skin, Enum.PartType.Ball)
	local la = newPart(model, "LeftArm", Vector3.new(1, 2, 1), skin)
	local ra = newPart(model, "RightArm", Vector3.new(1, 2, 1), skin)
	local ll = newPart(model, "LeftLeg", Vector3.new(1, 2, 1), Color3.fromRGB(45, 45, 65))
	local rl = newPart(model, "RightLeg", Vector3.new(1, 2, 1), Color3.fromRGB(45, 45, 65))

	torso.CFrame = cf
	local function attach(part, offset)
		part.CFrame = cf * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = torso
		w.Part1 = part
		w.Parent = part
	end
	attach(head, CFrame.new(0, 1.65, 0))
	attach(la, CFrame.new(-1.5, 0, 0))
	attach(ra, CFrame.new(1.5, 0, 0))
	attach(ll, CFrame.new(-0.5, -2, 0))
	attach(rl, CFrame.new(0.5, -2, 0))
	model.PrimaryPart = torso

	local parts = { torso, head, la, ra, ll, rl }
	local colors = {}
	for _, p in ipairs(parts) do
		colors[p] = p.Color
		p.Anchored = true
	end
	model.Parent = dummyFolder

	-- health bar
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(130, 36)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 18)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = "DUMMY  100/100"
	label.Parent = bb
	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.fromOffset(0, 21)
	barBg.Size = UDim2.new(1, 0, 0, 10)
	barBg.BackgroundColor3 = BLACK
	barBg.BackgroundTransparency = 0.2
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 5)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromHSV(0.33, 0.85, 1)
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

	dummies[model] = {
		model = model, torso = torso, parts = parts, colors = colors,
		hp = 100, max = 100, fill = fill, label = label, bb = bb,
		token = 0, dead = false,
	}
end

local function standUp(d)
	if not d.torso.Parent then return end
	local pos = d.torso.Position
	local gy = groundAt(pos) or pos.Y - 3
	d.torso.AssemblyLinearVelocity = Vector3.zero
	d.torso.AssemblyAngularVelocity = Vector3.zero
	for _, p in ipairs(d.parts) do p.Anchored = true end
	local rp = getRoot() and getRoot().Position or pos
	local base = Vector3.new(pos.X, gy + 3.05, pos.Z)
	d.model:PivotTo(CFrame.lookAt(base, Vector3.new(rp.X, base.Y, rp.Z)))
end

local function hitDummy(d, amount, fromPos, power)
	if d.dead or not d.torso.Parent then return end
	d.token += 1
	local token = d.token
	d.hp = math.max(0, d.hp - amount)
	updateBar(d)
	popup(d.torso.Position + Vector3.new(0, 3.5, 0), "-" .. math.floor(amount + 0.5), RED, 40)

	-- red/black flash on the dummy
	task.spawn(function()
		for _, p in ipairs(d.parts) do p.Color = BLACK end
		task.wait(0.05)
		for _, p in ipairs(d.parts) do p.Color = RED end
		task.wait(0.06)
		for _, p in ipairs(d.parts) do
			if p.Parent then p.Color = d.colors[p] end
		end
	end)

	-- hit-stop, then launch
	for _, p in ipairs(d.parts) do p.Anchored = true end
	task.wait(0.09)
	if not d.torso.Parent then return end
	for _, p in ipairs(d.parts) do p.Anchored = false end

	local flat = Vector3.new(d.torso.Position.X - fromPos.X, 0, d.torso.Position.Z - fromPos.Z)
	local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, -1)
	d.torso.AssemblyLinearVelocity = dir * CONFIG.Force * power + Vector3.new(0, 35, 0)
	d.torso.AssemblyAngularVelocity = Vector3.new(rand(-12, 12), rand(-6, 6), rand(-12, 12))

	if d.hp <= 0 then
		d.dead = true
		task.delay(0.9, function()
			if not d.torso.Parent then return end
			local pos = d.torso.Position
			sparks(pos)
			popup(pos + Vector3.new(0, 3, 0), "DEFEATED", Color3.new(1, 1, 1), 30)
			for _, p in ipairs(d.parts) do
				TweenService:Create(p, TweenInfo.new(0.6), { Transparency = 1 }):Play()
			end
			if d.bb then d.bb:Destroy() end
			task.wait(0.7)
			d.model:Destroy()
			dummies[d.model] = nil
		end)
	else
		task.delay(2.8, function()
			if d.token == token and not d.dead then
				standUp(d)
			end
		end)
	end
end

local function nearestTarget(root)
	local best, bestDist
	for _, d in pairs(dummies) do
		if not d.dead and d.torso.Parent then
			local off = d.torso.Position - root.Position
			local dist = off.Magnitude
			local flat = Vector3.new(off.X, 0, off.Z)
			local ok = flat.Magnitude < 0.1 or flat.Unit:Dot(root.CFrame.LookVector) > 0.15
			if dist <= CONFIG.HitRange and ok and (not best or dist < bestDist) then
				best, bestDist = d, dist
			end
		end
	end
	return best
end

-- ================= main move =================
local function blackFlash()
	if busy or os.clock() - lastUse < CONFIG.Cooldown then return end
	local root, hum = getRoot(), getHum()
	if not root or not hum or hum.Health <= 0 then return end

	busy = true
	lastUse = os.clock()
	if os.clock() - lastHit <= CONFIG.ComboWindow then combo += 1 else combo = 1 end
	lastHit = os.clock()
	local power = math.min(1 + (combo - 1) * 0.25, 2)

	-- face + dash at target
	local target = nearestTarget(root)
	if target then
		local tp = target.torso.Position
		local flatPos = Vector3.new(tp.X, root.Position.Y, tp.Z)
		local dist = (flatPos - root.Position).Magnitude
		if dist > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, flatPos)
			root.AssemblyLinearVelocity = root.CFrame.LookVector * math.clamp((dist - 3) * 5, 0, 70)
		end
	else
		root.AssemblyLinearVelocity = root.CFrame.LookVector * 25
	end

	-- wind-up
	local cam = workspace.CurrentCamera
	local baseFov = cam and cam.FieldOfView
	if cam then
		TweenService:Create(cam, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { FieldOfView = baseFov - 8 }):Play()
	end
	TweenService:Create(cc, TweenInfo.new(0.2), { Saturation = -0.6, Brightness = -0.1 }):Play()
	flash.BackgroundColor3 = BLACK
	TweenService:Create(flash, TweenInfo.new(0.2), { BackgroundTransparency = 0.6 }):Play()
	aura(0.9)

	local c = getChar()
	local hand = c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm"))
	local handPos = hand and hand.Position or root.Position
	for _ = 1, 5 do
		makeBolt(handPos, Vector3.new(rand(-1, 1), rand(-1, 1), rand(-1, 1)).Unit, 2.8, RED, 0.12, Enum.Material.Neon)
	end
	task.wait(0.2)

	-- IMPACT
	root = getRoot()
	if not root then
		busy = false
		return
	end
	if cam then cam.FieldOfView = baseFov - 18 end
	if cam then
		TweenService:Create(cam, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { FieldOfView = baseFov }):Play()
	end

	local impact
	if target and target.torso.Parent then
		impact = target.torso.Position
	else
		impact = (root.CFrame * CFrame.new(0, 0.5, -3.5)).Position
	end

	if CONFIG.SoundId ~= "" then
		local s = Instance.new("Sound")
		s.SoundId = CONFIG.SoundId
		s.Volume = 1
		s.Parent = root
		s:Play()
		Debris:AddItem(s, 4)
	end

	-- damage + knockback to every dummy near the impact
	local hits = 0
	for _, d in pairs(dummies) do
		if not d.dead and d.torso.Parent and (d.torso.Position - impact).Magnitude <= 10 then
			hits += 1
			task.spawn(hitDummy, d, CONFIG.Damage * power * rand(0.9, 1.1), root.Position, power)
		end
	end

	-- visuals
	ball(impact, RED, Enum.Material.Neon, 1, 7 * power, 0.25, 0.1)
	ball(impact, BLACK, Enum.Material.SmoothPlastic, 1, 22 * power, 0.45, 0.2)
	ball(impact, RED, Enum.Material.Neon, 2, 30 * power, 0.55, 0.6)

	for i = 1, math.floor(14 * power) do
		local dir = Vector3.new(rand(-1, 1), rand(-1, 1), rand(-1, 1)).Unit
		local isRed = i % 2 == 0
		makeBolt(
			impact, dir, rand(8, 18) * power,
			isRed and RED or BLACK,
			isRed and rand(0.15, 0.35) or rand(0.3, 0.6),
			isRed and Enum.Material.Neon or Enum.Material.SmoothPlastic
		)
	end
	sparks(impact)
	groundRing(impact, power)
	debrisBurst(impact, power)
	screenEffects(power)
	shake((hits > 0 and 2 or 1.3) * power, 0.5)
	showTitle()

	busy = false
end

