local function shake(intensity, duration)
	if not CONFIG.Shake then return end
	local hum = getHum()
	if not hum then return end
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / duration
		if t >= 1 or not hum.Parent then
			hum.CameraOffset = Vector3.zero
			conn:Disconnect()
			return
		end
		local f = (1 - t) ^ 2 * intensity
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * f, (math.random() - 0.5) * f, (math.random() - 0.5) * f)
	end)
end

local function makeBolt(origin, dir, length, color, thick, material)
	local segs = 6
	local prev = origin
	for i = 1, segs do
		local jitter = Vector3.zero
		if i < segs then
			jitter = Vector3.new(rand(-1, 1), rand(-1, 1), rand(-1, 1)) * length * 0.13
		end
		local nextPos = origin + dir * (length * i / segs) + jitter
		local dist = (nextPos - prev).Magnitude
		if dist > 0.05 then
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = material
			p.Color = color
			p.Size = Vector3.new(thick, thick, dist)
			p.CFrame = CFrame.lookAt(prev, nextPos) * CFrame.new(0, 0, -dist / 2)
			p.Parent = fxFolder
			TweenService:Create(p, TweenInfo.new(rand(0.25, 0.45), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1,
				Size = Vector3.new(0.02, 0.02, dist),
			}):Play()
			Debris:AddItem(p, 0.6)
		end
		prev = nextPos
	end
end

