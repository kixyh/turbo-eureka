-- ================= chat commands =================
player.Chatted:Connect(function(msg)
	local cmd, arg = msg:lower():match("^[!;](%w+)%s*(.*)$")
	if not cmd then return end

	if cmd == "bf" or cmd == "blackflash" then
		blackFlash()

	elseif cmd == "spam" then
		local n = math.clamp(tonumber(arg) or 3, 1, 10)
		say("Chaining " .. n .. " Black Flashes!")
		task.spawn(function()
			for _ = 1, n do
				lastUse = 0
				blackFlash()
				task.wait(0.6)
			end
		end)

	elseif cmd == "dummy" then
		local root = getRoot()
		if not root then return end
		local n = math.clamp(tonumber(arg) or 1, 1, CONFIG.MaxDummies)
		for i = 1, n do
			local offset = (i - (n + 1) / 2) * 5
			spawnDummy((root.CFrame * CFrame.new(offset, 0, -10)).Position)
		end
		say("Spawned " .. n .. " dummy(s)")

	elseif cmd == "clear" or cmd == "cleardummies" then
		for model in pairs(dummies) do model:Destroy() end
		dummies = {}
		say("Dummies cleared")

	elseif cmd == "heal" then
		for _, d in pairs(dummies) do
			if not d.dead then
				d.hp = d.max
				updateBar(d)
			end
		end
		say("Dummies healed")

	elseif cmd == "dmg" then
		local n = tonumber(arg)
		if n then
			CONFIG.Damage = math.clamp(n, 1, 1000)
			say("Base damage: " .. CONFIG.Damage)
		else
			say("Usage: !dmg <number>")
		end

	elseif cmd == "force" then
		local n = tonumber(arg)
		if n then
			CONFIG.Force = math.clamp(n, 0, 400)
			say("Knockback force: " .. CONFIG.Force)
		else
			say("Usage: !force <number>")
		end

	elseif cmd == "combo" then
		say("Current combo: x" .. combo)

	elseif cmd == "shake" then
		CONFIG.Shake = (arg ~= "off")
		say("Camera shake: " .. (CONFIG.Shake and "ON" or "OFF"))

	elseif cmd == "button" then
		local on = (arg ~= "off")
		button.Visible = on
		dummyButton.Visible = on
		say("Buttons: " .. (on and "ON" or "OFF"))

	elseif cmd == "cd" then
		local n = tonumber(arg)
		if n then
			CONFIG.Cooldown = math.clamp(n, 0, 30)
			say("Cooldown: " .. CONFIG.Cooldown .. "s")
		else
			say("Usage: !cd <seconds>")
		end

	elseif cmd == "help" then
		say("!bf !spam !dummy !clear !heal !dmg !force !combo !shake !button !cd")
	end
end)

